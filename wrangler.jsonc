{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sokuto",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*", "/mcp", "/mcp/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sokuto-db",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "KV" }
  ],
  "ai": { "binding": "AI" },
  // Realtime inbox: one InboxHub per workspace holds the admin tabs' WebSockets (src/inbox-hub.ts).
  // SQLite-backed (the only kind on the free plan); wrangler deploy applies the migration.
  "durable_objects": {
    "bindings": [{ "name": "INBOX_HUB", "class_name": "InboxHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InboxHub"] }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "META_GRAPH_VERSION": "v25.0"
  }
}
